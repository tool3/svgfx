{
  "name": "@svgfx/postprocessing",
  "version": "0.4.0",
  "description": "Post-processing effects for any SVG. Scanlines, bloom, glitch, halftone and more — in, out, still an SVG.",
  "keywords": [
    "svg",
    "postprocessing",
    "post-processing",
    "effects",
    "filter",
    "glitch",
    "scanlines",
    "bloom",
    "halftone",
    "duotone",
    "design"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tool3/svgfx.git"
  },
  "bugs": {
    "url": "https://github.com/tool3/svgfx/issues"
  },
  "homepage": "https://github.com/tool3/svgfx#readme",
  "author": "Tal Hayut",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize.ts",
    "clean": "node scripts/clean.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "examples": "node examples/run-all.ts",
    "gallery": "node scripts/gallery.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
